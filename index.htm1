<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Get the Best Samples Now!</title>
  <meta name="description" content="Enter your information to get started and discover free samples." />
  <style>
    :root{
      --navy:#071b3d;
      --blue:#1769ff;
      --yellow:#ffd83d;
      --green:#16a34a;
      --text:#172033;
      --muted:#667085;
      --border:#e5e7eb;
      --bg:#f7f9fc;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
      color:var(--text);
      background:linear-gradient(180deg,#eef4ff 0,#fff 58%);
    }
    .topbar{
      height:7px;
      background:linear-gradient(90deg,#ef4444 0 33%,#fff 33% 66%,#2563eb 66%);
    }
    .wrap{max-width:1120px;margin:auto;padding:0 20px}
    header{
      display:flex;justify-content:space-between;align-items:center;
      padding:18px 0;
    }
    .brand{font-weight:900;font-size:22px;letter-spacing:-.5px}
    .brand span{color:var(--blue)}
    .trust{font-size:13px;color:#475467}
    .hero{
      display:grid;grid-template-columns:1.05fr .95fr;gap:44px;
      align-items:center;padding:62px 0 48px;
    }
    .eyebrow{
      display:inline-flex;align-items:center;gap:8px;
      background:#e8f0ff;color:#174ea6;border:1px solid #cfe0ff;
      border-radius:999px;padding:8px 12px;font-size:13px;font-weight:800;
    }
    h1{
      font-size:clamp(42px,6vw,68px);line-height:.98;
      letter-spacing:-2.8px;margin:18px 0 18px;
    }
    .accent{color:var(--blue)}
    .sub{font-size:18px;line-height:1.6;color:#475467;max-width:600px}
    .bullets{display:grid;gap:12px;margin:26px 0 0;padding:0;list-style:none}
    .bullets li{display:flex;gap:10px;align-items:center;font-weight:700}
    .check{
      width:24px;height:24px;border-radius:50%;display:grid;place-items:center;
      background:#dcfce7;color:#15803d;font-size:14px;flex:0 0 auto;
    }
    .card{
      background:#fff;border:1px solid #e4e7ec;border-radius:22px;
      box-shadow:0 18px 50px rgba(20,45,90,.13);padding:28px;
    }
    .card h2{margin:0 0 8px;font-size:25px}
    .card p{margin:0 0 20px;color:var(--muted);line-height:1.5}
    label{display:block;font-size:13px;font-weight:800;margin:14px 0 7px}
    input,select{
      width:100%;padding:14px 15px;border:1px solid #d0d5dd;border-radius:11px;
      font-size:15px;outline:none;background:#fff;
    }
    input:focus,select:focus{border-color:#7aa7ff;box-shadow:0 0 0 4px #e8f0ff}
    .cta{
      width:100%;border:0;border-radius:12px;padding:15px 18px;margin-top:20px;
      background:var(--yellow);color:#171717;font-size:17px;font-weight:900;cursor:pointer;
      box-shadow:0 7px 0 #e7b900;transition:.15s transform,.15s box-shadow;
    }
    .cta:hover{transform:translateY(-1px);box-shadow:0 8px 0 #e7b900}
    .cta:active{transform:translateY(4px);box-shadow:0 3px 0 #e7b900}
    .fine{font-size:11px;line-height:1.5;color:#98a2b3;text-align:center;margin:14px 0 0}
    .notice{
      display:none;margin-top:14px;padding:12px;border-radius:10px;
      background:#ecfdf3;color:#027a48;font-weight:700;font-size:13px;text-align:center;
    }
    .features{padding:22px 0 70px}
    .featuregrid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    .feature{
      background:#fff;border:1px solid var(--border);border-radius:16px;padding:22px;
    }
    .icon{font-size:25px}
    .feature h3{margin:12px 0 7px;font-size:17px}
    .feature p{margin:0;color:#667085;line-height:1.55;font-size:14px}
    footer{border-top:1px solid var(--border);padding:25px 0;color:#98a2b3;font-size:12px;text-align:center}
    @media(max-width:800px){
      .hero{grid-template-columns:1fr;padding:40px 0}
      .featuregrid{grid-template-columns:1fr}
      header .trust{display:none}
    }
  </style>
</head>
<body>
  <div class="topbar"></div>

  <div class="wrap">
    <header>
      <div class="brand">Super<span>Samples</span></div>
      <div class="trust">🔒 Secure &nbsp;•&nbsp; Free to join</div>
    </header>

    <main>
      <section class="hero">
        <div>
          <div class="eyebrow">🇺🇸 US • FREE SAMPLE OPPORTUNITY</div>
          <h1>Get the <span class="accent">Best Samples</span> Now!</h1>
          <p class="sub">
            Enter your information to get started. Discover sample opportunities
            and complete the steps required to claim your offer.
          </p>

          <ul class="bullets">
            <li><span class="check">✓</span> Quick and simple signup</li>
            <li><span class="check">✓</span> No payment required to start</li>
            <li><span class="check">✓</span> Mobile-friendly experience</li>
          </ul>
        </div>

        <div class="card">
          <h2>Interested in samples?</h2>
          <p>Fill in your details below to continue.</p>

          <form id="leadForm">
            <label for="name">Full name</label>
            <input id="name" name="name" type="text" placeholder="Your full name" required />

            <label for="email">Email address</label>
            <input id="email" name="email" type="email" placeholder="you@example.com" required />

            <label for="state">State</label>
            <select id="state" name="state" required>
              <option value="">Select your state</option>
              <option>Alabama</option><option>Alaska</option><option>Arizona</option>
              <option>Arkansas</option><option>California</option><option>Colorado</option>
              <option>Connecticut</option><option>Florida</option><option>Georgia</option>
              <option>Illinois</option><option>Maryland</option><option>Massachusetts</option>
              <option>Michigan</option><option>New Jersey</option><option>New York</option>
              <option>North Carolina</option><option>Ohio</option><option>Pennsylvania</option>
              <option>Texas</option><option>Virginia</option><option>Washington</option>
              <option>Other</option>
            </select>

            <button class="cta" type="submit">Claim My Free Samples →</button>
            <a href="https://singingfiles.com/show.php?l=0&u=2505499&id=75092&tracking_id=razdee" style="display:block;text-align:center;margin-top:14px;color:#1769ff;font-weight:800;text-decoration:none;">Continue to offer</a>
            <div class="notice" id="notice">Thanks! Replace the demo CTA URL in the code to connect this form to your offer.</div>
            <p class="fine">
              By continuing, you agree to the applicable terms and privacy policy.
              Offer availability and eligibility may vary.
            </p>
          </form>
        </div>
      </section>

      <section class="features">
        <div class="featuregrid">
          <article class="feature">
            <div class="icon">🎁</div>
            <h3>Sample Opportunities</h3>
            <p>Explore available sample offers and promotions presented through the campaign.</p>
          </article>
          <article class="feature">
            <div class="icon">⚡</div>
            <h3>Simple Process</h3>
            <p>Complete the form and continue through the required offer steps.</p>
          </article>
          <article class="feature">
            <div class="icon">📱</div>
            <h3>Works on Mobile</h3>
            <p>A responsive layout designed for phones, tablets, and desktop screens.</p>
          </article>
        </div>
      </section>
    </main>

    <footer>
      © 2026 SuperSamples • This page is a promotional landing-page template.
    </footer>
  </div>

  <script>
    document.getElementById('leadForm').addEventListener('submit', function(e){
      e.preventDefault();

      // IMPORTANT:
      // Replace this demo behavior with your authorized offer/affiliate URL,
      // form endpoint, or tracking URL.
      const offerUrl = 'https://singingfiles.com/show.php?l=0&u=2505499&id=75092&tracking_id=razdee';

      if (offerUrl !== 'https://singingfiles.com/show.php?l=0&u=2505499&id=75092&tracking_id=razdee') {
        window.location.href = offerUrl;
        return;
      }

      document.getElementById('notice').style.display = 'block';
    });
  </script>
</body>
</html>
